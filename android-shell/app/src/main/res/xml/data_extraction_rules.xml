<?xml version="1.0" encoding="utf-8"?>
<!--
  F6A data extraction rules (Android 12+).
  Keep private identity material off cloud backup and device-to-device transfer.
  HYPER CORE TECH
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sos_native_identity_secure_v1.xml" />
        <exclude domain="sharedpref" path="sos_native_session.xml" />
        <exclude domain="sharedpref" path="sos_native_session_authority_v1.xml" />
        <exclude domain="sharedpref" path="sos_native_device_identity_v1.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sos_native_identity_secure_v1.xml" />
        <exclude domain="sharedpref" path="sos_native_session.xml" />
        <exclude domain="sharedpref" path="sos_native_session_authority_v1.xml" />
        <exclude domain="sharedpref" path="sos_native_device_identity_v1.xml" />
    </device-transfer>
</data-extraction-rules>

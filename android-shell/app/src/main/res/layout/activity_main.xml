<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.sos010.app.SosWebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerInParent="true"
        android:indeterminate="true" />

    <!-- So-Call: לוגו קטן חצי־שקוף + from HTC כמו וואטסאפ | HYPER CORE TECH -->
    <RelativeLayout
        android:id="@+id/soCallSplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF0B141A"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:elevation="20dp">

        <ImageView
            android:id="@+id/soCallSplashLogo"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_above="@id/soCallSplashFooter"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="96dp"
            android:alpha="0.22"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name_sos_call"
            android:scaleType="fitCenter"
            android:src="@drawable/so_call_splash_logo" />

        <LinearLayout
            android:id="@+id/soCallSplashFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/so_call_splash_from"
                android:textColor="#8696A0"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="12dp"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@string/so_call_splash_htc"
                android:src="@drawable/ic_htc_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="@string/so_call_splash_htc"
                android:textColor="#8696A0"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- חיווי בחירת קובץ – רקע חזק + ספינר/טקסט בלי מסגרת | HYPER CORE TECH -->
    <FrameLayout
        android:id="@+id/filePickLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2000000"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="8dp">

            <ProgressBar
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:indeterminate="true"
                android:indeterminateTint="#53BDEB" />

            <TextView
                android:id="@+id/filePickLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="טוען..."
                android:textColor="#E9EDEF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</RelativeLayout>

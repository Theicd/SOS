<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.sos010.app.SosWebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerInParent="true"
        android:indeterminate="true" />

    <!-- חיווי בחירת קובץ – רקע חזק + ספינר/טקסט בלי מסגרת | HYPER CORE TECH -->
    <FrameLayout
        android:id="@+id/filePickLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2000000"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="8dp">

            <ProgressBar
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:indeterminate="true"
                android:indeterminateTint="#53BDEB" />

            <TextView
                android:id="@+id/filePickLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="טוען..."
                android:textColor="#E9EDEF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</RelativeLayout>

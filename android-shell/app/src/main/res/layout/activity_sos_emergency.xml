<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <LinearLayout
        android:id="@+id/stationRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

    <Button
        android:id="@+id/backToNetworkButton"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#4CAF50"
        android:text="← חזרה לרשת החברתית"
        android:textColor="#ffffff" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp"
        android:text="🚨 מצב חירום"
        android:textColor="#00d4ff"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/networkName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#4ade80"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/networkPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textColor="#4ade80"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#16213e"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐 סטטוס רשת"
            android:textColor="#00d4ff"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wifiStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Wi-Fi: בודק..."
            android:textColor="#eeeeee"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/hotspotStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="נקודה חמה: בודק..."
            android:textColor="#eeeeee"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/locationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="מיקום: בודק..."
            android:textColor="#eeeeee"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/ipAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="כתובת IP: בודק..."
            android:textColor="#fbbf24"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="4dp"
        android:text="@string/emergency_home_steps"
        android:textColor="#cccccc"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/relayStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:text=""
        android:textColor="#888888"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/usersStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#4ade80"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#2a2a4a"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 הגדרות נקודה חמה"
            android:textColor="#fbbf24"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hotspotHintSsid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textColor="#f87171"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hotspotHintPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#f87171"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="הנקודה החמה נשארת דלוקה. כרטיס הרשת מחפש SOS אחרים. מיקום חייב להיות דלוק."
            android:textColor="#aaaaaa"
            android:textSize="12sp" />
    </LinearLayout>

        <Button
            android:id="@+id/openConnectButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#00d4ff"
            android:text="@string/emergency_open_connect_screen"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/openHotspotSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#fbbf24"
            android:text="הגדרות נקודה חמה"
            android:textColor="#000000" />

        <Button
            android:id="@+id/startRelayButton"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/runTestsButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#333355"
            android:text="בדיקות"
            android:textColor="#888888"
            android:textSize="11sp" />

        <Button
            android:id="@+id/serviceLogButton"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="#333355"
            android:text="לוג"
            android:textColor="#888888"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📜 לוג מסך"
            android:textColor="#888888"
            android:textSize="14sp" />

        <Button
            android:id="@+id/copyLogButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#58a6ff"
            android:text="העתק לוג"
            android:textColor="#000000" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="#0d1117">

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="8dp"
            android:textColor="#58a6ff"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>
    </LinearLayout>

    <include layout="@layout/layout_sos_emergency_wizard" />
</FrameLayout>
